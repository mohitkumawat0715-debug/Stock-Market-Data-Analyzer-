# Stock Market Data Analyzer - Non-Secret Runtime Configuration Template
# Copy this file to .env for local customization:
#   Copy-Item .env.example .env
# Never store real credentials in tracked files. The local .env file is gitignored.

STOCK_ANALYZER_APP_NAME="Stock Market Data Analyzer API"
STOCK_ANALYZER_ENV="development"
STOCK_ANALYZER_HOST="127.0.0.1"
STOCK_ANALYZER_PORT="8000"

# Comma-separated list of frontend origins permitted by CORS (Next.js local dev server)
STOCK_ANALYZER_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional override path for local OHLCV CSV files (defaults to backend/data/sample)
# STOCK_ANALYZER_CSV_DIR="backend/data/sample"

# --- Phase 3: persistence (SQLite, created and migrated automatically at startup) ---
# Defaults to backend/data/stock_analyzer.db (gitignored). Override with any SQLAlchemy URL.
# STOCK_ANALYZER_DATABASE_URL="sqlite:///backend/data/stock_analyzer.db"

# --- Phase 3: optional quote polling (leave empty to stay fully offline on CSV data) ---
# Free Finnhub key from https://finnhub.io (personal-use free tier; review their terms).
# Never commit a real key. Only the local, gitignored .env should contain it.
FINNHUB_API_KEY=""
# Polling only runs when this is true AND a key is set.
STOCK_ANALYZER_QUOTE_POLLING_ENABLED="false"
# Seconds between polling cycles (minimum 30). Free tier allows 60 calls per minute.
STOCK_ANALYZER_QUOTE_POLL_INTERVAL_SECONDS="120"
# Maximum tickers fetched per cycle, to stay inside provider rate limits.
STOCK_ANALYZER_QUOTE_MAX_SYMBOLS_PER_CYCLE="20"
# A quote is labeled "recent" if its trade time is within this many minutes of now.
STOCK_ANALYZER_QUOTE_RECENT_MINUTES="20"

# Default backtest modeling assumptions
STOCK_ANALYZER_DEFAULT_RISK_FREE_RATE="0.02"
STOCK_ANALYZER_DEFAULT_TRANSACTION_COST_BPS="10.0"
